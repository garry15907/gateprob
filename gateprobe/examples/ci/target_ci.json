{
  "name": "티켓 시연 스택 (CI)",
  "region": "ap-northeast-1",
  "auth": {
    "type": "sigv4"
  },
  "gateways": {
    "open": "env:GATEPROBE_URL_OPEN",
    "guarded": "env:GATEPROBE_URL_GUARDED"
  },
  "classify": {
    "policy_deny_codes": [
      -20001
    ],
    "rules": [
      {
        "when": {
          "is_error": true,
          "text_matches": "^An internal error occurred"
        },
        "then": "UNKNOWN"
      },
      {
        "when": {
          "path": "error.type",
          "in": [
            "AccessDeniedException",
            "AccessDenied"
          ]
        },
        "then": "IAM_DENY"
      },
      {
        "when": {
          "path": "error",
          "exists": true
        },
        "then": "TOOL_ERROR"
      },
      {
        "when": {
          "is_error": true
        },
        "then": "TOOL_ERROR"
      }
    ],
    "default": "ALLOW"
  }
}

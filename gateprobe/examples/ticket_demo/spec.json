{
  "name": "티켓 도구 권한과 정책 점검",
  "target": "ticket-tools",
  "scenarios": [
    {
      "id": "read_ticket",
      "설명": "정상 조회",
      "steps": [{"tool": "get_ticket", "args": {"ticket_id": "T-100"}, "expect": "ALLOW"}]
    },
    {
      "id": "read_missing",
      "설명": "없는 티켓. 권한 문제가 아니라 도구 오류로 나와야 함",
      "steps": [{"tool": "get_ticket", "args": {"ticket_id": "T-{run}"}, "expect": "TOOL_ERROR"}]
    },
    {
      "id": "comment_plain",
      "설명": "평범한 메모 추가",
      "steps": [{"tool": "add_comment", "args": {"ticket_id": "T-100", "text": "확인 중입니다"}, "expect": "ALLOW"}]
    },
    {
      "id": "comment_with_link",
      "설명": "외부 링크가 든 메모. guarded에서만 막힘",
      "steps": [{"tool": "add_comment", "args": {"ticket_id": "T-100", "text": "자세한 내용은 https://paste.example/{run}"},
                 "expect": {"open": "ALLOW", "guarded": "POLICY_DENY"}}]
    },
    {
      "id": "export_internal",
      "설명": "내부 경로로 내보내기",
      "steps": [{"tool": "export_tickets", "args": {"destination": "internal/reports/{run}"}, "expect": "ALLOW"}]
    },
    {
      "id": "export_external",
      "설명": "외부 주소로 내보내기. guarded에서만 막힘",
      "steps": [{"tool": "export_tickets", "args": {"destination": "https://paste.example/{run}"},
                 "expect": {"open": "ALLOW", "guarded": "POLICY_DENY"}}]
    },
    {
      "id": "delete_ticket",
      "설명": "삭제. open은 IAM이, guarded는 정책이 먼저 막음. 없는 티켓 ID라 허용돼도 지워지는 것은 없음",
      "steps": [{"tool": "delete_ticket", "args": {"ticket_id": "T-NONE-{run}"},
                 "expect": {"open": "IAM_DENY", "guarded": "POLICY_DENY"}}]
    },
    {
      "id": "read_after_denied",
      "설명": "거부된 호출 뒤에도 같은 세션의 정상 조회는 허용",
      "steps": [
        {"tool": "export_tickets", "args": {"destination": "https://paste.example/{run}"}},
        {"tool": "get_ticket", "args": {"ticket_id": "T-200"}, "expect": "ALLOW"}
      ]
    }
  ]
}
